# Stripe API Configuration Template
# Copy this file to .env (which is gitignored) and fill in your own values.
# Never commit real keys.

# Restricted secret key (server-side only). STRIPE_API_KEY is used by scripts/stripe_sync.mjs.
STRIPE_SECRET_KEY=rk_live_your_restricted_key_here
STRIPE_API_KEY=rk_live_your_restricted_key_here

# Webhook signing secret (Developers > Webhooks, or `stripe listen`).
# Required when a live key is set; without it the webhook rejects all events.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Price IDs (written by `node scripts/stripe_sync.mjs --update-env`)
STRIPE_PRICE_PRO_MONTHLY=price_xxx_pro_monthly
STRIPE_PRICE_PRO_ANNUAL=price_xxx_pro_annual
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxx_enterprise_monthly
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_xxx_enterprise_annual

# --- Bring-your-own media (nothing below is bundled or defaulted) ---
# Your own licensed Windows ISO (Windows path or \\wsl.localhost\... path)
POSTCARD_WINDOWS_ISO=
# Optional remote KVM host for the macOS card, e.g. user@host (ssh key auth required)
POSTCARD_KVM_HOST=
POSTCARD_KVM_WORKDIR=~/postcard-kvm
# Your own Apple SMC key for macOS guests. You must supply it yourself.
POSTCARD_MAC_OSK=
