{
  "name": "micro-host-parent-delegator",
  "private": true,
  "description": "Parent delegator for Post Card Spatial OS (UNC & WSL safe)",
  "scripts": {
    "dev": "node --input-type=module -e \"import p from 'node:path';import u from 'node:url';const d=p.dirname(process.env.npm_package_json||process.env.INIT_CWD);process.argv=['node','run-vite.mjs','dev'];await import(u.pathToFileURL(p.join(d,'micro-host/workspace-prototype/run-vite.mjs')).href)\"",
    "build": "node --input-type=module -e \"import p from 'node:path';import u from 'node:url';const d=p.dirname(process.env.npm_package_json||process.env.INIT_CWD);process.argv=['node','run-vite.mjs','build'];await import(u.pathToFileURL(p.join(d,'micro-host/workspace-prototype/run-vite.mjs')).href)\"",
    "preview": "node --input-type=module -e \"import p from 'node:path';import u from 'node:url';const d=p.dirname(process.env.npm_package_json||process.env.INIT_CWD);process.argv=['node','run-vite.mjs','preview'];await import(u.pathToFileURL(p.join(d,'micro-host/workspace-prototype/run-vite.mjs')).href)\"",
    "test": "node --input-type=module -e \"import p from 'node:path';import u from 'node:url';const d=p.dirname(process.env.npm_package_json||process.env.INIT_CWD);process.argv=['node','run-vite.mjs','test'];await import(u.pathToFileURL(p.join(d,'micro-host/workspace-prototype/run-vite.mjs')).href)\"",
    "build:all": "powershell -ExecutionPolicy Bypass -File ./build-all.ps1",
    "build:kernel": "powershell -ExecutionPolicy Bypass -Command \"Set-Location kernel; cargo build --release --target x86_64-unknown-none --target-dir ../target\"",
    "build:ui": "powershell -ExecutionPolicy Bypass -Command \"Set-Location workspace-prototype; npm run build\"",
    "test:all": "powershell -ExecutionPolicy Bypass -File ./build-all.ps1 -RunTests",
    "boot:iso": "powershell -ExecutionPolicy Bypass -File ./boot-postcard-iso.ps1",
    "studio": "powershell -ExecutionPolicy Bypass -File ./launch-postcard-os.ps1"
  }
}
